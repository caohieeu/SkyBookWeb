@using SkyBookWeb.Application.Dtos;

@model IEnumerable<ProductDto>

@{
    ViewData["Title"] = "Home Page";
}


<!-- Hero Section -->
<partial name="_Hero" />

<!-- Catalog Section -->
<div class="container py-5" id="catalog">
    <div class="mb-4">
        <h2 class="fw-bold mb-1">Our Collection</h2>
        <p class="text-secondary mb-0">Explore all 25 books in our catalog</p>
    </div>

    <!-- Books Grid -->
    @if(Model != null && Model.Any())
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">

            @foreach(var item in Model)
            {
            <div class="col">
                <div class="card h-100 border shadow-sm book-card">
                    <a asp-controller="Product" asp-action="Detail" asp-route-productId="@item.Id" class="text-decoration-none">
                        <div style="aspect-ratio: 3/4; overflow: hidden;">
                            <div class="w-100 h-100 d-flex align-items-center justify-content-center bg-light">
                                <img src="@item.ImageUrl" style="width: 100%" />
                            </div>
                        </div>
                    </a>
                    <div class="card-body">
                        <span class="badge bg-secondary mb-2">@item.Category</span>
                        <h6 class="card-title fw-semibold mb-2" style="min-height: 2.5rem;">
                            <a href="#" class="text-decoration-none text-dark">
                                @item.Title
                            </a>
                        </h6>
                        <p class="text-secondary small mb-2">by @item.Author</p>
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <span class="fw-bold text-success">@item.Price100.ToString("c")</span>
                                    @if(item.ListPrice > item.Price100)
                                    {
                                        <small class="text-decoration-line-through text-muted ms-1">@item.ListPrice.ToString("c")</small>
                                    }
                                </div>
                            <!-- TODO: Link to details page with product ID -->
                            <a href="#" class="btn btn-sm btn-outline-dark">
                                View
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            }
        </div>
    }
</div>

<partial name="_Newsletter" />