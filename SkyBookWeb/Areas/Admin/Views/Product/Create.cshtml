@using SkyBookWeb.Core.Entities;

@model Product

<div class="container-fluid">
    <a href="#" class="text-decoration-none text-secondary small fw-medium d-inline-flex align-items-center gap-1 mb-3">
        <i class="bi bi-arrow-left"></i> Back to products
    </a>
    <div class="card border shadow-sm overflow-hidden">
        <div class="card-header text-white py-3 px-4" style="background: linear-gradient(to right, #065f46, #282828, #191414);">
            <h5 class="mb-0 fw-bold"><i class="bi bi-plus-lg me-2"></i>Create Product</h5>
            <p class="mb-0 small" style="color: #1DB954;">Add a new product</p>
        </div>
        <div class="card-body p-4">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            <form method="post">
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Product Name</label>
                    <input asp-for="Title" type="text" name="Name" class="form-control" placeholder="Enter product name" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-accent fw-semibold">Create Product</button>
                    <a asp-controller="Product" asp-action="Index" class="btn btn-light fw-medium">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
