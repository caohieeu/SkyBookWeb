@using SkyBookWeb.Core.Entities;

@model Product

<div class="container-fluid">
    <a href="#" class="text-decoration-none text-secondary small fw-medium d-inline-flex align-items-center gap-1 mb-3">
        <i class="bi bi-arrow-left"></i> Back to categories
    </a>
    <div class="card border shadow-sm overflow-hidden">
        <div class="card-header text-white py-3 px-4" style="background: linear-gradient(to right, #065f46, #282828, #191414);">
            <h5 class="mb-0 fw-bold"><i class="bi bi-plus-lg me-2"></i>Update Category</h5>
            <p class="mb-0 small" style="color: #1DB954;">Update a category for your products</p>
        </div>
        <div class="card-body p-4">
            <div asp-validation-summary="All" class="text-danger"></div>
            <form method="post" asp-action="Update">
                <input asp-for="Id" hidden />
                <div class="col-lg-8">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-semibold small">Product Name</label>
                            <input asp-for="Title" type="text" name="Title" class="form-control" placeholder="Enter product name" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold small">Product Name</label>
                            <input asp-for="Description" type="text" name="Description" class="form-control" placeholder="Enter description" />
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold small">ISBN</label>
                            <input asp-for="ISBN" type="text" name="ISBN" class="form-control" placeholder="Enter ISBN" />
                            <span asp-validation-for="ISBN" class="text-danger small"></span>
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold small">Author</label>
                            <input asp-for="Author" type="text" name="Author" class="form-control" placeholder="Enter author" />
                            <span asp-validation-for="Author" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <!--image-->
                </div>
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-accent fw-semibold">Update Category</button>
                    <a asp-controller="Category" asp-action="Index" class="btn btn-light fw-medium">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
