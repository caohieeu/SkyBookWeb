@using SkyBookWeb.Models.ViewModels

@model ProductVM

<div class="container-fluid">
    <a href="#" class="text-decoration-none text-secondary small fw-medium d-inline-flex align-items-center gap-1 mb-3">
        <i class="bi bi-arrow-left"></i> Back to products
    </a>
    <div class="card border shadow-sm overflow-hidden">
        <div class="card-header text-white py-3 px-4" style="background: linear-gradient(to right, #065f46, #282828, #191414);">
            <h5 class="mb-0 fw-bold"><i class="bi bi-plus-lg me-2"></i>Update Category</h5>
            <p class="mb-0 small" style="color: #1DB954;">Update a product</p>
        </div>
        <div class="card-body p-4">
            <div asp-validation-summary="All" class="text-danger"></div>
            <form method="post" asp-action="Upsert" enctype="multipart/form-data">
                <input asp-for="Product.Id" hidden />
                <input asp-for="Product.ImageUrl" hidden />
                <div class="row">
                    <div class="col-lg-8">
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label fw-semibold small">Product Name</label>
                                <input asp-for="Product.Title" type="text" class="form-control" />
                                <span asp-validation-for="Product.Title" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold small">Description</label>
                                <textarea asp-for="Product.Description" class="form-control"></textarea>
                                <div id="quill-editor" style="height: 200px;"></div>
                                <span asp-validation-for="Product.Description" class="text-danger small"></span>
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-semibold small">ISBN</label>
                                <input asp-for="Product.ISBN" type="text" class="form-control" placeholder="Enter ISBN" />
                                <span asp-validation-for="Product.ISBN" class="text-danger small"></span>
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-semibold small">Author</label>
                                <input asp-for="Product.Author" type="text" class="form-control" placeholder="Enter author" />
                                <span asp-validation-for="Product.Author" class="text-danger small"></span>
                            </div>
                            <div class="border rounded p-3 mt-3 bg-light">
                                <p class="text-uppercase fw-bold text-secondary mb-3" style="font-size: 0.65rem; letter-spacing: 0.1em">Pricing</p>
                                <div class="row g-3">
                                    <div class="col-6 col-md-3">
                                        <label class="form-label fw-semibold small">List Price</label>
                                        <input asp-for="Product.ListPrice" type="text" class="form-control" />
                                        <span asp-validation-for="Product.ListPrice" class="text-danger small"></span>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <label class="form-label fw-semibold small">Price for 1-50</label>
                                        <input asp-for="Product.Price" type="text" class="form-control" />
                                        <span asp-validation-for="Product.Price" class="text-danger small"></span>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <label class="form-label fw-semibold small">Price for 50+</label>
                                        <input asp-for="Product.Price50" type="text" class="form-control" />
                                        <span asp-validation-for="Product.Price50" class="text-danger small"></span>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <label class="form-label fw-semibold small">Price for 100+</label>
                                        <input asp-for="Product.Price100" type="text" class="form-control" />
                                        <span asp-validation-for="Product.Price100" class="text-danger small"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="mt-3">
                                <label asp-for="Product.CategoryId" class="form-label fw-semibold small"></label>
                                <select asp-for="Product.CategoryId" asp-items="@Model.CategoryList" class="form-select">
                                    <option disabled selected>---Select Category---</option>
                                </select>
                                <span asp-validation-for="Product.CategoryId" class="text-danger small"></span>
                            </div>
                            <div class="mt-3">
                                <label asp-for="Product.ImageUrl" class="form-label fw-semibold small"></label>
                                <div class="border-2 rounded p-4 text-center" style="border: dashed">
                                    <i class="bi bi-cloud-upload fs-4 text-secondary"></i>
                                    <input type="file" name="fileImage" accept="image/*" class="form-control form-control-sm mt-2" />
                                    <p class="text-secondary mt-1 mb-0" style="font-size: 0.75rem;">Upload a single product image (JPG, PNG)</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <!--image-->
                        @if (!string.IsNullOrEmpty(Model.Product?.ImageUrl))
                        {
                            <div class="border rounded p-3 bg-light text-center">
                                <p class="text-uppercase text-secondary fw-semibold mb-2">Current image</p>
                                <img src="@Model.Product.ImageUrl" class="img-fluid rounded shadow-sm mb-2" />
                                <p class="text-secondary mb-0" style="font-size: 0.75rem;">Upload a new image to replace this one</p>
                            </div>
                        }
                        else
                        {
                            <div class="border rounded p-3 bg-light text-center">
                                <p class="text-uppercase text-secondary fw-semibold mb-2">Current image</p>
                                <i class="bi bi-image" style="font-size: 3rem; color: #94a3b8"></i>
                                <p class="text-secondary mb-0" style="font-size: 0.75rem;">No Image</p>
                            </div>
                        }
                    </div>
                </div>
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-accent fw-semibold">Update Product</button>
                    <a asp-controller="Product" asp-action="Index" class="btn btn-light fw-medium">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section scripts {
    <link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>

    <script>
        const quill = new Quill('#quill-editor', {
          theme: 'snow'
        });

        var textAreaDesc = document.querySelector('textarea[name="Product.Description"]');

        if(textAreaDesc.value) quill.root.innerHTML = textAreaDesc.value;

        quill.on('text-change', () => textArea.roo)
    </script>
}